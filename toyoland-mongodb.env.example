# Toyoland MongoDB Configuration
# Copy this to your .env file in the backend directory

# MongoDB Connection String
# Format: mongodb://[username:password@]host[:port]/[database][?options]
MONGO_URI=mongodb://admin:11223345@localhost:27017/toyoland-store?authSource=admin&authMechanism=SCRAM-SHA-256

# Alternative: If using MongoDB Atlas (cloud), uncomment and update:
# MONGO_URI=mongodb+srv://admin:<password>@cluster.mongodb.net/toyoland-store?retryWrites=true&w=majority

# MongoDB Host (for standalone connection)
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_DATABASE=toyoland-store
MONGODB_USERNAME=admin
MONGODB_PASSWORD=11223345
MONGODB_AUTH_SOURCE=admin

# Connection Pool Settings (optional)
MONGODB_MAX_POOL_SIZE=10
MONGODB_MIN_POOL_SIZE=5

# Node Environment
NODE_ENV=development

# Server Port
PORT=5092

# API Configuration
API_URL=http://localhost:5092
FRONTEND_URL=http://localhost:3000
DASHBOARD_URL=http://localhost:8005
